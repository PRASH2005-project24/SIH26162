# ============================================================================
# SIH26162 Environment Configuration
# Local Development: Native PostgreSQL + PostGIS (Windows)
# ============================================================================

# ============================================================================
# DATABASE CONNECTION (REQUIRED)
# ============================================================================
# Configure your local PostgreSQL connection here.
# Do NOT commit a real password to git.
#
# Example for local PostgreSQL on Windows:
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/sih26162
#
# Replace YOUR_PASSWORD with your local PostgreSQL password
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/sih26162

# ============================================================================
# Backend Configuration
# ============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_ENV=development
LOG_LEVEL=INFO

# ============================================================================
# FIRMS API (NASA Thermal Anomalies)
# ============================================================================
# Get your FIRMS API key from: https://firms.modaps.eosdis.nasa.gov/api/
# Leave empty for demo mode
FIRMS_MAP_KEY=

# Bounding box for polling (Pune pilot region by default)
# Format: min_lat,min_lon,max_lat,max_lon
FIRMS_BBOX=17.35,73.50,19.00,75.50

# Polling interval in minutes
FIRMS_POLLING_INTERVAL_MINUTES=30

# ============================================================================
# Demo Mode
# ============================================================================
# Enable mock thermal data when FIRMS_MAP_KEY unavailable
# Set to 'true' for testing without API credentials
DEMO_MODE=true

# ============================================================================
# Storage Configuration (Local File Storage)
# ============================================================================
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./backend/data/storage
STORAGE_RETENTION_DAYS=730

# ============================================================================
# Geospatial Configuration
# ============================================================================

# Pilot region (Pune, Maharashtra)
PILOT_BBOX=17.35,73.50,19.00,75.50
PILOT_NAME=pune_maharashtra

# India-wide region (for future expansion)
INDIA_BBOX=8.0,68.0,35.0,97.0

# OpenStreetMap cache TTL (seconds)
# Default: 7 days = 604800 seconds
OSM_CACHE_TTL_SECONDS=604800

# Event analysis buffers (metres)
EVENT_BUFFER_1KM=1000
EVENT_BUFFER_5KM=5000

# ============================================================================
# Google Earth Engine (Stage 1B - Dynamic World Land Cover)
# ============================================================================
# Optional: For Dynamic World queries, register a Google Cloud project
# 1. Create project at https://console.cloud.google.com/
# 2. Enable Earth Engine API
# 3. Set project ID below
EARTH_ENGINE_PROJECT_ID=

# Optional: Path to service account JSON (for CI/CD)
# Usually set via GOOGLE_APPLICATION_CREDENTIALS env var instead
EARTH_ENGINE_CREDENTIALS_PATH=

# ============================================================================
# Frontend Configuration
# ============================================================================
REACT_APP_API_BASE=http://localhost:8000

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:8000
