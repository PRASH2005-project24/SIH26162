# Fire Intelligence Dashboard - Configuration Template
# Copy values as needed. Configuration is stored in browser localStorage.
# These values are used when "Demo Mode" is disabled in Settings.

# =====================================================
# STAGE 1/1B BACKEND CONFIGURATION
# =====================================================

# Primary API Base URL for thermal events and enrichment
# The backend should provide:
#   GET /events - list of thermal events
#   GET /events/{id} - single event details
#   GET /events/{id}/enrichment - enrichment data
#   GET /statistics - dashboard statistics
API_BASE_URL=http://localhost:8000/api

# =====================================================
# STAGE 2 ML SERVICE CONFIGURATION
# =====================================================

# ML prediction service endpoint
# The service should accept:
#   POST /predict with event data
# And return:
#   { predicted_class, confidence, risk_score, risk_level, model_version, key_factors }
ML_SERVICE_URL=http://localhost:5000/predict

# =====================================================
# MAP CONFIGURATION
# =====================================================

# Default map center latitude (India center: 22.9734)
MAP_CENTER_LAT=22.9734

# Default map center longitude (India center: 78.6569)
MAP_CENTER_LNG=78.6569

# Default map zoom level (5 = India view)
MAP_DEFAULT_ZOOM=5

# =====================================================
# DASHBOARD CONFIGURATION
# =====================================================

# Enable demo mode (true = use mock data, false = use real API)
DEMO_MODE=true

# Theme preference (light | dark)
THEME=light

# Auto-refresh interval in seconds (0 = disabled)
AUTO_REFRESH_INTERVAL=300

# Enable map marker clustering
ENABLE_CLUSTERING=false

# =====================================================
# NOTES
# =====================================================

# 1. These values are stored in browser localStorage via src/config.js
# 2. Settings can be changed via the Dashboard Settings page
# 3. Demo mode provides complete test data without requiring backend
# 4. All URLs should include protocol (http:// or https://)
# 5. CORS headers must be configured on backend APIs
# 6. ML service URL can differ from API base URL (separate services)
